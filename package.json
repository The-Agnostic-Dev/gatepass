{
  "name": "gatepass",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node server/index.js",
    "build": "ng build",
    "dev": "ng serve --proxy-config proxy.conf.json",
    "dev:api": "PORT=3000 node --watch server/index.js",
    "test": "ng test --watch=false && npm run test:server",
    "test:server": "MAIL_LATENCY_MS=0 node --test \"server/test/**/*.test.js\""
  },
  "private": true,
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "express": "^5.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "type": "module"
}
